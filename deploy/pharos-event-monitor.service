[Unit]
Description=Pharos Chain MCP Event Log Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/event-log-monitor
Environment=NODE_ENV=production
EnvironmentFile=-/home/ubuntu/event-log-monitor/.env.service
ExecStart=/usr/bin/env node --dns-result-order=ipv4first src/cli.mjs --data-dir /home/ubuntu/event-log-monitor/data --port 8791
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/event-log-monitor/data
UMask=0077

[Install]
WantedBy=multi-user.target
