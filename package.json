{
  "name": "pharos-event-log-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only persistent Pharos Chain MCP Transfer monitor with Cloudflare Pages dashboard",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "bin": {"pharos-event-monitor": "src/cli.mjs"},
