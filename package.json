{
  "name": "pharos-event-log-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only persistent Pharos Chain MCP Transfer monitor with Cloudflare Pages dashboard",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pharos-event-monitor": "src/cli.mjs"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/cli.mjs",
    "check": "node scripts/check.mjs",
    "format:check": "prettier --check \"src/**/*.mjs\" \"functions/**/*.js\" \"public/**/*.js\" \"scripts/**/*.mjs\" \"test/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.mjs\" \"functions/**/*.js\" \"public/**/*.js\" \"scripts/**/*.mjs\" \"test/**/*.mjs\"",
    "test": "node --test test/*.test.mjs",
    "build": "npm run check && npm run format:check && npm test"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
